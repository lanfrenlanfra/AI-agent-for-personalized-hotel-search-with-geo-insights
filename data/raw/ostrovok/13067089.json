owed","shower","tea","tea-or-coffee","toiletries","tv","wardrobe"],"images":["/t/{size}/extranet/60/06/6006d3f64521782310b6a5daef42d40779009a62.JPEG","/t/{size}/extranet/1c/e5/1ce50d99f28edc35891faa7a3f0352c130319b33.JPEG","/t/{size}/extranet/46/d5/46d561afea185464aff1286664377b0222b7bd18.JPEG","/t/{size}/extranet/09/57/0957bfaa1487d387336e19125bcb0ef1a1edd9d9.JPEG"]}],"reviews":[{"id":"1443034","date":"2025-01-29","plus":"Очень хороший опыт проживания, красивое озеро Байкал, деревянные домики в лесу.В номере очень тепло, чисто и хорошо оборудовано.За окном открывается прекрасный вид на лес, и обслуживание продавца также на высшем уровне.Большое вам спасибо за то, что у вас остались такие приятные впечатления от путешествия.","minus":"-","text":"","rating":10,"room":"Стандартный одноместный номер","traveller":null,"trip":"leisure","adults":1,"children":null,"detailed":{"cleanness":10,"location":10,"price":10,"services":10,"room":10},"wifi_quality":"unused","images":[]},{"id":"1484397","date":"2025-03-25","plus":"Здесь чистые, теплые и красивые комнаты, а за окнами виднеется красивый лес.Хозяин очень милый и полный энтузиазма, и это отличное впечатление от путешествия.","minus":"-","text":"","rating":10,"room":"Стандартный одноместный номер","traveller":"solo_travel","trip":"leisure","adults":1,"children":null,"detailed":{"cleanness":10,"location":10,"price":10,"services":10,"room":10,"wifi":10},"wifi_quality":"perfect","images":[]},{"id":"1565971","date":"2025-06-05","plus":"Дом расположен в глубине ущелья недалеко от выхода на ББТ. Хотела спокойно отдохнуть в тишине. Достался угловой номер с 2 окнами, в одном сосны и березы, в другом - поросшая лесом гора и ствол сосны рядом с домом. Открываешь окно - щебечут птицы. Можно лежать и слушать. Уютная кухня. На улице беседка. Приветливые хозяева. До Байкала идти минут 15, там уже магазины и экскурсионные киоски. Специально выбирала место подальше от курортной суеты. Если еще приеду в Листвянку - снова к ним обращусь","minus":"Из мебели только кровать, узкая полочка над ней, два подоконника и вешалка на стене. Я бы добавила на эту вешалку плечики, чтобы можно было вешать одежду. Так приходится складывать все в пакетах на пол. Душевая кабина прямо в комнате за шторкой, надо проветривать чтобы не пахло сыростью","text":"","rating":9.1,"room":"Одноместный номер Standard","traveller":"solo_travel","trip":"leisure","adults":1,"children":null,"detailed":{"cleanness":10,"location":10,"price":10,"services":10,"room":10,"wifi":7,"hygiene_quality":7},"wifi_quality":"slow","images":[]},{"id":"2176578","date":"2026-06-16","plus":"Дом оказался даже лучше, чем на фото! Внутри идеально чисто и по-домашнему комфортно, а на улице — ухоженный двор, где приятно проводить вечера. Хозяева предусмотрели всё необходимое на кухне и в ванной. Главный бонус — близость к Байкальской тропе: вышел из калитки и сразу на маршрут. Очень рекомендуем эти апартаменты для тех, кто хочет совместить уют и активный отдых»","minus":"-","text":"","rating":10,"room":"Двухместный номер Superior (двуспальная кровать) (внешняя собственная ванная комната)","traveller":"couple","trip":"leisure","adults":2,"children":null,"detailed":{"cleanness":10,"location":10,"price":10,"services":10,"room":10,"wifi":10},"wifi_quality":"perfect","images":[]}],"review_images":[{"review_id":"2176578","path":"/t/{size}/hotel_review/8d/ec/8decb25ee6ecdc543e9f8526901650fdc1d4340a.JPEG"},{"review_id":"1565971","path":"/t/{size}/hotel_review/6a/9a/6a9a82bb33b3228e732f2bddf5c167232f6b9b33.JPEG"},{"review_id":"1565971","path":"/t/{size}/hotel_review/c1/81/c181fe763b9c5658bb1125aa9da601e38aa07868.JPEG"},{"review_id":"1565971","path":"/t/{size}/hotel_review/26/7e/267e65f5139009e36a9b4df4a29e0c0ece6dc507.JPEG"},{"review_id":"1484397","path":"/t/{size}/hotel_review/35/01/3501c503ea21e972bbde63dad125d5d9c2e492d0.JPEG"},{"review_id":"1484397","path":"/t/{size}/hotel_review/d7/7e/d77e346a7719821a5c261aab7864cb659affe4dc.JPEG"},{"review_id":"1484397","path":"