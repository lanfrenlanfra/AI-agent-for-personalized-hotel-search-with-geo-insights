amenities":["balcony","bathrobe","bedsheets","dining-area","fridge","heating","high-speed-internet-access","iron","kitchen","kitchen-stuff","microwave","mirror","private-bathroom","private-entrance","safe","tea","telephone","toiletries","towels","tv","wardrobe","with-view"],"images":["/t/{size}/extranet/66/98/6698c286d81a016e3e9e9716b963d07b3a088e22.jpeg","/t/{size}/extranet/5a/10/5a106213a64117b91b7c37c58d712793764688ad.jpeg","/t/{size}/extranet/65/42/6542c4fe4d70087ad07923f0204e68fcca55675d.jpeg","/t/{size}/extranet/5f/06/5f06c57e8ea464d77d4d5edc6b14c918a4d0934f.jpeg"]},{"name":"Апартаменты с 2 комнатами","bedding":"","size":43,"amenities":["private-bathroom"],"images":["/t/{size}/extranet/c9/64/c964b07362cafa436833d4c6f42585ea736ce84c.jpeg","/t/{size}/extranet/71/fa/71fa683aa287c1c91e156fca182aede554c6c629.jpeg","/t/{size}/extranet/a1/15/a115b95d6a1cc0a66119bad39c6dff6f2c796bc4.jpeg","/t/{size}/extranet/3d/38/3d38b97468a2603f3e83753c92f4991090b5be0a.jpeg"]},{"name":"Коттедж Президент с балконом и с красивым видом из окна","bedding":"","size":230,"amenities":["balcony","bathrobe","bedsheets","dining-area","fridge","hairdryer","heating","iron","kitchen","kitchen-stuff","microwave","private-bathroom","safe","slippers","tea","tea-or-coffee","telephone","toiletries","tv","wardrobe","with-view"],"images":["/t/{size}/extranet/26/8f/268fa695afa24266570e73336ce2ded27ff9858e.jpeg","/t/{size}/extranet/c4/24/c4247319ec2f58e8cc5f02f60514667307e18294.jpeg","/t/{size}/extranet/68/6e/686e028cafd3ef41ec0b135d943c626fe1e048b7.jpeg","/t/{size}/extranet/ea/2e/ea2e088605df0e041839b6e14b0596d0241c34fa.jpeg"]}],"reviews":[{"id":"1325539","date":"2024-09-27","plus":"Потрясающая база! Выше всяких похвал! Территория очень красивая! До Байкала 5 мин. ходьбы. Нам повезло с температурой воды и мы купались каждый день.Номер просторный, чистый, постельное белье, матрац- супер👍👍👍 Единственное место, где спалось, как дома))) Уборка в номерах каждый день. Девочки  все приветливые. За завтрак отдельный респект!!! Такого ассортимента не встречали нигде! Каши, яйцо вар., омлет двух видов, творожная запеканка или сырники, гарниры, курица или тефтели(🔥),овощи, соусы разнообразные, топпинги, выпечка, сыры, колбасы, чай, кофе, соки... Всего не перечислишь...Очень все вкусно! Отдельное спасибо хочу сказать администратору Аюне, очень доброжелательная и отзывчивая девушка!!! У меня возникли проблемы со здоровьем, сделала всё,  что было в её силах. Предложила вызвать скорую , благо, что всё обошлось!!! Очень приятно такое отношение! Спасибо большое 🌸 🌸 🌸  \r\nОбязательно будем рекомендовать вашу базу!","minus":"Всё понравилось)","text":"","rating":10,"room":"Двухместный номер Standard с балконом (двуспальная кровать)","traveller":null,"trip":"leisure","adults":2,"children":null,"detailed":{"cleanness":10,"location":10,"price":10,"services":10,"room":10,"meal":10},"wifi_quality":null,"images":[]},{"id":"1682823","date":"2025-08-01","plus":"Отношение девочек администраторов и управляющего смены ресторана Миша по отношению к нам, у нас совпали все беды, которые только могли случиться. Сначала нас заселили не в тот номер, который мы оплатили, заселили в дешевый, страшный номер со странным запахом и горбом на кровати, мы были в шоке и почти смирились, но нас в течении часа переселили в апартаменты и мы успокоились. \r\nВ ресторане нам подали пугающий борщ с сырой картошкой, пересушенными гренками и салом которое невозможно прожевать. Управляющая глядя на наши страдания оперативно вмешалась, накормила нас тортиком с брусникой, успокоила и исключила из чека борщ. \r\nСотрудники - главное достояние Байкальской Ривьеры, неравнодушные, милые и добрые. \r\nОчень жаль что номерной фонд с каждым годом выглядит все удручающе , там и тут отломанные ручки на мебели, вздутый пол, скрипучие двери,  сантехника дышит на ладан. Купальня в бане это аттракцион в который страшно залазить, конструкция с  прошлого года так и не починен, висит на сопле, а падать с нее высоко. Единственное место в Гремячинске где отдыхаем становится ветхим, жаль жаль.. \r\nЗавтраки вкусные, массажист Ольга отлично, баня без купели и исправник - отдельное спасибо.","minus":"Номерной фонд уходит как эпоха, вложитесь пожалуйста в ремонт. \r\nОфицианты не знают меню, не умеют предлагать, рекламировать блюда, просто сваливают и забывают про гостей. Алкоголь по меню кроме пива весь был на стопе. \r\nИ наладьте пожалуйста партнерку с островком чтобы номера забронированные на островке совпадали на месте с тем что на фото. И не получилось как у нас, когда нас поселили в номер ниже классом.","text":"","rating":6.3,"room":"Двухместный номер Стандарт Улучшенный (двуспальная кровать)","traveller":"couple","trip":"leisure","adults":2,"children":null,"detailed":{"cleanness":7,"location":5,"price":5,"services":10,"room":5,"meal":5,"wifi":7},"wifi_quality":"slow","images":[]},{"id":"1994729","date":"2026-02-07","plus":"Расроложен парк-отель в красивейшем месте. Великолепный двухкомнатный номер: чистый, уютный, с красивой мебелью и всем необходимым наполнением. Все вопросы, которые у нас возникали, решались оперативно и чётко. Зимний отдых не так богат на развлечения, тем не менее мы воспользовались услугами проката коньков, посетили баню с купелью на улице, по рекомендации нашли смотровую площадку, пройдя по экотропе. Завтраки, включённые в стоимость проживания, в ресторане \"Миша\" нас полностью удовлетворили. Ресторан очень уютный, шикарно оформлен, с хорошей кухней и приветливым персоналом. Отдельное спасибо администратору отеля Анастасии, которая курировала наше пребывание в Байкальской Ревьере. В том числе и за организацию трансфера.","minus":"Понравилось все!!","text":"","rating":10,"room":"Трёхместный номер Стандарт с 2 комнатами","traveller":"family","trip":"leisure","adults":3,"children":null,"detailed":{"cleanness":10,"location":10,"price":10,"services":10,"room":10,"meal":10,"wifi":10,"hygiene_quality":10},"wifi_quality":"perfect","images":[]},{"id":"2014286","date":"2026-02-20","plus":"","minus":"","text":"","rating":10,"room":"Двухместный номер Стандарт (2 отдельные кровати) (тип кровати может измениться)","traveller":"company","trip":"leisure","adults":2,"children":null,"detailed":{"cleanness":10,"location":10,"price":10,"services":10,"room":10},"wifi_quality":null,"images":[]},{"id":"2378071","date":"2026-10-06","plus":"Хорошая база отдыха\r\nОтличные завтраки - шведский стол в красивом ресторане.\r\nПриветливые девушки на ресепшн. Отдельное спасибо, что выдали по просьбе напольную сушилку в номер.\r\nКрасивые места на берегу и если пройтись по берегу , то там можно найти квадроциклы, катамараны и т.д. Есть киоск фаст-фуда на берегу. К базе это не относится, но удобно.","minus":"-","text":"","rating":10,"room":"Двухместный номер Стандарт (двуспальная кровать) (тип кровати может измениться)","traveller":"solo_travel","trip":"leisure","adults":1,"children":null,"detailed":{"cleanness":10,"location":10,"price":10,"services":10,"room":10},"wifi_quality":null,"images":[]}],"review_images":[{"review_id":"2378071","path":"/t/{size}/hotel_review/37/ac/37ac778f1498823dae72b3592a528cc5b7bd004e.JPEG"},{"review_id":"2378071","path":"/t/{size}/hotel_review/8e/db/8edb31352c40e46ad83c2cdb2ac0803e3d1b5c28.JPEG"},{"review_id":"2378071","path":"/t/{size}/hotel_review/47/76/47768df1fb3a4d877c2ab5e74cbfccf3b836a4ee.JPEG"},{"review_id":"2378071","path":"/t/{size}/hotel_review/61/62/6162d7340efe98f5327e56fd5b5905b68fe61b74.JPEG"},{"review_id":"2378071","path":"/t/{size}/hotel_review/3e/b7/3eb73a1c085ee07410365bc8d77c621db4da9959.JPEG"},{"review_id":"2014286","path":"/t/{size}/hotel_review/d0/4c/d04c5626d4bffd4e27a0ac4234ff62d36ab46b22.JPEG"},{"review_id":"1994729","path":"/t/{size}/hotel_review/1b/e9/1be9371c7c8e586dceee6e4f8ac226902e722222.JPEG"},{"review_id":"1994729","path":"/t/{size}/hotel_review/a6/f5/a6f5fb54b76e0b170405c786945399d84e550b57.JPEG"},{"review_id":"1994729","path":"/t/{size}/hotel_review/8c/86/8c86b37c214237ec1744e6bc2122da6a118caddd.JPEG