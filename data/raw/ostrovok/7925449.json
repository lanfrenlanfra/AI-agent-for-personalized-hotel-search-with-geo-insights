/4b/ce/4bce46a40c5e1c5de92b47e7a1b999520de08428.jpeg","/t/{size}/extranet/44/d3/44d3d69715241a550e510f51badf424850f24c0e.jpeg","/t/{size}/extranet/6f/9f/6f9ff8e78ccee6af97b221ff94b3f6cfe58187d6.jpeg"]}],"reviews":[{"id":"14367611","date":"2020-02-24","plus":"","minus":"","text":"Цена 15 000 рублей. Грязный номер с мухами, без бара и сервиса. За что деньги берут непонятно. \nПри заселении у них н работает безналичный расчет. на Ресепшен сидит мальчик которому все равно. Ресторан ужасно готовит, есть невозможно. Были там 2-й раз, ничего не меняется. Из плюсов красивый вид в окно. Но не за те деньги что они берут. Не рекомендую.","rating":4,"room":null,"traveller":null,"trip":null,"adults":0,"children":0,"detailed":{"cleanness":0,"location":0,"price":0,"services":0,"room":0,"meal":0,"wifi":0,"hygieneQuality":0,"checkInCheckOut":0},"wifi_quality":null,"images":[]},{"id":"14367612","date":"2019-07-07","plus":"","minus":"","text":"произведя поиск номеров в данном отеле, нашелся 1 номер для 3 взрослых, была произведена бронь номера с сайта- бронь отель подтвердил, но после звонка в отель оказалось что данных номеров который уже ПОДТВЕРЖДЕН у них в наличии нет свободных на эту дату(тур под в листвянке под эти даты был подобран после брнирования отеля), по телефону администратор мне сказала что а вы вообще то знаете что были выходные???(я звоню в понедельник) я говорю, и что?она- а то что в выходные наш бухгалтер не сделал отметку на сайте что таких номеров уже нет, и предлагает мне заселение в два стандартных номер но цене ДВУХ стандартных, на минточку тот который был изначально забронирован он за 3-х стоит 6.000 руб, а ОДИН стандарт 5700*2=11400. это нормально???? никаких контактов связаться с директором администратор не предоставляет, исходя из этого в отеле творится какой то бардак,не жили в этом отеле никогда, и никогда не будем, и всем друзьям теперь будем советовать не обращаться туда.","rating":2,"room":null,"traveller":null,"trip":"FAMILY","adults":0,"children":0,"detailed":{"cleanness":0,"location":0,"price":0,"services":0,"room":0,"meal":0,"wifi":0,"hygieneQuality":0,"checkInCheckOut":0},"wifi_quality":null,"images":[]},{"id":"7480968","date":"2018-12-01","plus":"","minus":"","text":"Ребята я по роду своей работы бывал в городках о которых мало, кто слышал. Например г.Калач или Палласовка.И там гостиницы. А это не гостиница . Начнем с персонала горничная Таня , бегает по этажам в кожаных бруках , каждый день в одних и тех же. Никакой формы фартука ничего ,думаю и мед. книжкой там не пахло. Повар Зина вроде готовит вам завтрак или ужин при этом сто раз покурит того гляди и бычек попадет в салат.И ещё просто крикливая женщина с прокуренным голосом. Кушать не хочется. Администраторы в 12 ночи закроют дверь и лягут спать , охраны нет. Пожарная сигнализация не работает. В номере шумно и холодно. Два раза был свидетелем банкета , оба раза люди разочаровались. Мобильная связь там не берет , интернет есть но на 5 этаже он не ловит. Вид на Байкал это да красотища особенно с 17 номера. Думаю тут заслуга Байкала а не этой забегаловки . Не рекомендую .","rating":2,"room":null,"traveller":null,"trip":"BUSINESS","adults":0,"children":0,"detailed":{"cleanness":0,"location":0,"price":0,"services":0,"room":0,"meal":0,"wifi":0,"hygieneQuality":0,"checkInCheckOut":0},"wifi_quality":null,"images":[]}],"review_images":[]}