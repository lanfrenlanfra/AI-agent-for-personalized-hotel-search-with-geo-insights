# Порт приложения (внутри контейнера всегда 8080)
APP_PORT=8080

# --- LLM (необязательно) ---
# Любой OpenAI-совместимый API. Без ключа всё работает на правилах (офлайн):
# LLM нужен только для более умного разбора запросов/ответов отельера,
# имитации отельера и описания новых характеристик текстом.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Данные ---
# Регион демо (каталог Островка)
REGION_SLUG=russia/st._petersburg
# Сколько отелей собирать командой collect
COLLECT_LIMIT=60
# Пауза между запросами к ostrovok.ru и Overpass, сек
COLLECT_DELAY=1.5

# --- Кабинет отельера (демо-доступ) ---
HOTELIER_LOGIN=hotelier
HOTELIER_PASSWORD=hotelier123

# --- Актуализация данных ---
# Фоновая перепроверка устаревших значений (только офлайн-коллекторы без сети)
REFRESH_ENABLED=false
REFRESH_INTERVAL_MIN=60
