# Порт приложения (внутри контейнера всегда 8080)
APP_PORT=8080

# --- LLM ---
# По умолчанию вместе с сервисом поднимается Ollama и сама скачивает небольшую модель (≈2 ГБ, первый запуск).
# Приложение не ждёт: пока модель качается, работают правила и записанные ответы, потом подключается LLM.
COMPOSE_PROFILES=llm
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
# Заголовок OpenAI-Project, нужен только Yandex AI Studio (идентификатор каталога)
LLM_PROJECT=
#
# Свой API вместо встроенной Ollama: уберите значение COMPOSE_PROFILES (оставьте COMPOSE_PROFILES=) и впишите:
#  Ollama на вашем компьютере (бесплатно):
#    LLM_BASE_URL=http://host.docker.internal:11434/v1
#    LLM_API_KEY=ollama
#    LLM_MODEL=qwen3.5:4b            # ollama pull qwen3.5:4b
#  Yandex AI Studio:
#    LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
#    LLM_API_KEY=<API-ключ сервисного аккаунта>
#    LLM_PROJECT=<идентификатор каталога>
#    LLM_MODEL=gpt://<идентификатор каталога>/yandexgpt/latest
#  Без LLM вовсе: COMPOSE_PROFILES= и LLM_API_KEY= — всё работает на правилах.

# --- Данные ---
# Регион (каталог Островка): «Отели у озера Байкала»
REGION_SLUG=russia/baykal
# Стартовая глубокая выборка командой collect (разные районы, цены, типы). Остальные отели региона
# сервис проверяет сам, по запросам пользователей.
COLLECT_LIMIT=60
# Сколько страниц каталога обойти для индекса региона (по 20 отелей; ≈1500 страниц — весь Петербург)
COLLECT_CATALOG_PAGES=100
# Дозаполнение по запросу: ставить в очередь лучших кандидатов из каталога и проверять их в фоне
ENRICH_ON_DEMAND=true
# Сколько кандидатов ставить в очередь за один запрос и сколько глубоких проверок разрешено в час
ENRICH_BATCH=8
ENRICH_MAX_PER_HOUR=120
# Пауза между запросами к ostrovok.ru и Overpass, сек
COLLECT_DELAY=1.5

# --- Кабинет отельера (демо-доступ) ---
HOTELIER_LOGIN=hotelier
HOTELIER_PASSWORD=hotelier123

# --- Актуализация данных ---
# Фоновая перепроверка устаревших значений
REFRESH_ENABLED=false
REFRESH_INTERVAL_MIN=60
# true — перекачивать карточку, отзывы и карту с ostrovok.ru/Overpass; false — пересчёт по сохранённому
REFRESH_ONLINE=false
