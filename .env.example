# Порт приложения (внутри контейнера всегда 8080)
APP_PORT=8080

# --- LLM ---
# По умолчанию вместе с сервисом поднимается Ollama и сама скачивает небольшую модель gemma3:4b (≈3,3 ГБ, первый запуск; понимает и картинки).
# Приложение не ждёт: пока модель качается, работают правила и записанные ответы, потом подключается LLM.
COMPOSE_PROFILES=llm
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma3:4b
# Заголовок OpenAI-Project, нужен только Yandex AI Studio (идентификатор каталога)
LLM_PROJECT=
#
# Свой API вместо встроенной Ollama: уберите значение COMPOSE_PROFILES (оставьте COMPOSE_PROFILES=) и впишите:
#  Ollama на вашем компьютере (бесплатно):
#    LLM_BASE_URL=http://host.docker.internal:11434/v1
#    LLM_API_KEY=ollama
#    LLM_MODEL=qwen3.5:4b            # ollama pull qwen3.5:4b
#  Yandex AI Studio:
#    LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
#    LLM_API_KEY=<API-ключ сервисного аккаунта>
#    LLM_PROJECT=<идентификатор каталога>
#    LLM_MODEL=gpt://<идентификатор каталога>/yandexgpt/latest
#  GigaChat (Сбер) — облачная модель, понимает и картинки:
#    COMPOSE_PROFILES=                      # локальная Ollama не нужна
#    LLM_PROVIDER=gigachat
#    GIGACHAT_AUTH_KEY=<«Ключ авторизации» из личного кабинета developers.sber.ru>
#    GIGACHAT_SCOPE=GIGACHAT_API_PERS       # физлица; для организаций GIGACHAT_API_B2B или GIGACHAT_API_CORP
#    GIGACHAT_MODEL=GigaChat-2              # текст: разбор запросов, ответы лягушки
#    GIGACHAT_VISION_MODEL=GigaChat-2-Max   # фото гостей; если в тарифе её нет — поставьте доступную модель с картинками
#    GIGACHAT_MAX_PARALLEL=1                # бесплатный тариф пускает один запрос за раз
#  Проверка: docker compose exec app python scripts/check_llm.py (покажет токен, доступные модели и разбор картинки).
#  Корневой сертификат Минцифры Dockerfile скачивает сам (см. certs/README.md).
#  Без LLM вовсе: COMPOSE_PROFILES= и LLM_API_KEY= — всё работает на правилах.

# --- Данные ---
# Регион (каталог Островка): «Отели у озера Байкала»
REGION_SLUG=russia/baykal
# Стартовая глубокая выборка командой collect (разные районы, цены, типы). Остальные отели региона
# сервис проверяет сам, по запросам пользователей.
COLLECT_LIMIT=60
# Сколько страниц каталога обойти для индекса региона (по 20 отелей; ≈1500 страниц — весь Петербург)
COLLECT_CATALOG_PAGES=100
# Дозаполнение по запросу: ставить в очередь лучших кандидатов из каталога и проверять их в фоне
ENRICH_ON_DEMAND=true
# Сколько кандидатов ставить в очередь за один запрос и сколько глубоких проверок разрешено в час
ENRICH_BATCH=8
ENRICH_MAX_PER_HOUR=120
# Пауза между запросами к ostrovok.ru и Overpass, сек
COLLECT_DELAY=1.5

# --- Кабинет отельера (демо-доступ) ---
HOTELIER_LOGIN=hotelier
HOTELIER_PASSWORD=hotelier123

# --- Актуализация данных ---
# Фоновая перепроверка устаревших значений
REFRESH_ENABLED=false
REFRESH_INTERVAL_MIN=60
# true — перекачивать карточку, отзывы и карту с ostrovok.ru/Overpass; false — пересчёт по сохранённому
REFRESH_ONLINE=false

# --- Рельеф и внешние источники «скрытых» характеристик ---
# Цифровая модель рельефа (плитки Terrarium, ключ не нужен): учитывает горы при расчёте заката, вида и подъёмов пешком
DEM_ENABLED=true
# Докачивать недостающие плитки при онлайн-проверке отеля (офлайн всегда берётся кэш data/raw/dem)
DEM_FETCH=true
# Ходить за климатом, воздухом, Википедией и фото при онлайн-проверке (иначе только сохранённые ответы)
PROBES_ONLINE=true
PROBE_TIMEOUT=8
# Необязательно: ключ OpenCellID для оценки сотовой связи (https://opencellid.org)
OPENCELLID_KEY=
# Типовая высота леса, м (для расчёта видимости)
FOREST_HEIGHT_M=14
